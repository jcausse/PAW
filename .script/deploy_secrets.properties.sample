[DEPLOYMENT]
# SSH Configuration (used for uploading the WAR file via SCP and executing commands)
ssh_username = your_ssh_username
ssh_password = your_ssh_password
ssh_server = your_ssh_server_ip_or_domain
ssh_port = 22

# SFTP Configuration (used for deploying the WAR to Tomcat's web directory from the SSH server)
sftp_username = your_sftp_username
sftp_password = your_sftp_password
sftp_server = your_sftp_server_ip_or_domain

[DATABASE]
# Database Configuration (used for generating database dumps via pg_dump on the SSH server)
db_host = your_db_host
db_user = your_db_user
db_password = your_db_password
db_database = your_db_database
